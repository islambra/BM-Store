PORT=5000
MONGODB_URI=your_mongodb_connection_string
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Google Cloud Translation API
# ---------------------------
# 1) Enable the Cloud Translation API on your Google Cloud project.
# 2) Provide ONE of the following credential approaches:
#
#    Option A — Application Default Credentials (ADC):
#      Run:  gcloud auth application-default login
#      Then configure the project id:
#      GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
#
#    Option B — Service Account JSON file (local development):
#      Download the service account key JSON and set its path:
#      GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account.json
#
#    Option C — Inline service account JSON (production / platform secrets):
#      Paste the raw JSON of the service account key into the secret value.
#      GOOGLE_CLOUD_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"...","private_key_id":"..."}
#
# IMPORTANT: never commit real credentials. The value above is a placeholder only.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CREDENTIALS_JSON=